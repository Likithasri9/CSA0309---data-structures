12. Application of Stack – Notations

#include <stdio.h>
#include <ctype.h>

char stack[20];
int top = -1;

void push(char x) {
    stack[++top] = x;
}

char pop() {
    return stack[top--];
}

int priority(char x) {
    if(x == '+' || x == '-') return 1;
    if(x == '*' || x == '/') return 2;
    return 0;
}

int main() {
    char exp[20], x;
    int i;

    printf("Enter infix expression: ");
    scanf("%s", exp);

    printf("Postfix: ");

    for(i=0; exp[i]!='\0'; i++) {
        x = exp[i];

        if(isalnum(x))
            printf("%c", x);
        else if(x == '(')
            push(x);
        else if(x == ')') {
            while(stack[top] != '(')
                printf("%c", pop());
            pop();
        }
        else {
            while(top != -1 && priority(stack[top]) >= priority(x))
                printf("%c", pop());
            push(x);
        }
    }

    while(top != -1)
        printf("%c", pop());

    return 0;
}

Output:

Enter infix expression: A+B*C
Postfix: ABC*+
