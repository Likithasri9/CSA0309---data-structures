9. Binary Search

Note: The elements must be in sorted order.

#include <stdio.h>

int main() {
    int a[10], n, key, low, high, mid, found=0;
    int i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter sorted elements:\n");
    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    printf("Enter number to search: ");
    scanf("%d", &key);

    low = 0;
    high = n - 1;

    while(low <= high) {
        mid = (low + high) / 2;

        if(a[mid] == key) {
            printf("Element found at position %d", mid+1);
            found=1;
            break;
        }
        else if(key < a[mid])
            high = mid - 1;
        else
            low = mid + 1;
    }

    if(!found)
        printf("Element not found");

    return 0;
}

