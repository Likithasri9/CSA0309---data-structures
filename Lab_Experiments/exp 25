25. Minimum Spanning Tree – Kruskal's Algorithm
#include <stdio.h>

struct Edge {
    int u, v, w;
};

int parent[5];

int find(int x) {
    while(parent[x] != x)
        x = parent[x];

    return x;
}

void unite(int a, int b) {
    parent[find(a)] = find(b);
}

int main() {
    struct Edge e[] = {
        {0,1,2},
        {1,2,1},
        {0,2,3},
        {1,3,4},
        {2,3,5},
        {2,4,6},
        {3,4,7}
    };

    int n=7, i, j, temp;
    int count=0, total=0;

    for(i=0; i<5; i++)
        parent[i] = i;

    /* Sort edges */
    for(i=0; i<n-1; i++) {
        for(j=0; j<n-i-1; j++) {
            if(e[j].w > e[j+1].w) {
                temp=e[j].w;
                e[j].w=e[j+1].w;
                e[j+1].w=temp;

                temp=e[j].u;
                e[j].u=e[j+1].u;
                e[j+1].u=temp;

                temp=e[j].v;
                e[j].v=e[j+1].v;
                e[j+1].v=temp;
            }
        }
    }

    printf("Edges in MST:\n");

    for(i=0; i<n && count<4; i++) {
        if(find(e[i].u) != find(e[i].v)) {
            printf("%d - %d = %d\n", e[i].u, e[i].v, e[i].w);

            total += e[i].w;
            unite(e[i].u, e[i].v);
            count++;
        }
    }

    printf("Total cost = %d", total);

    return 0;
}

