17. Merge Sort
#include <stdio.h>

void merge(int a[], int l, int m, int r) {
    int i=l, j=m+1, k=0, b[20];

    while(i<=m && j<=r) {
        if(a[i] < a[j])
            b[k++] = a[i++];
        else
            b[k++] = a[j++];
    }

    while(i<=m)
        b[k++] = a[i++];

    while(j<=r)
        b[k++] = a[j++];

    for(i=l, k=0; i<=r; i++)
        a[i] = b[k++];
}

void mergeSort(int a[], int l, int r) {
    int m;

    if(l < r) {
        m = (l+r)/2;
        mergeSort(a,l,m);
        mergeSort(a,m+1,r);
        merge(a,l,m,r);
    }
}

int main() {
    int a[10], n, i;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    mergeSort(a,0,n-1);

    printf("Sorted array: ");
    for(i=0; i<n; i++)
        printf("%d ",a[i]);

    return 0;
}

