8. Linear Search
#include <stdio.h>

int main() {
    int a[10], n, key, i, found=0;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements:\n");
    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    printf("Enter number to search: ");
    scanf("%d", &key);

    for(i=0; i<n; i++) {
        if(a[i] == key) {
            printf("Element found at position %d", i+1);
            found=1;
            break;
        }
    }

    if(!found)
        printf("Element not found");

    return 0;
}

Output:

