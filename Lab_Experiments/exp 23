23. Shortest Path – Dijkstra's Algorithm
#include <stdio.h>

#define INF 999

int main() {
    int graph[5][5] = {
        {0,10,3,INF,INF},
        {10,0,1,2,INF},
        {3,1,0,8,2},
        {INF,2,8,0,7},
        {INF,INF,2,7,0}
    };

    int dist[5], visited[5] = {0};
    int i, j, min, u;

    for(i=0; i<5; i++)
        dist[i] = graph[0][i];

    dist[0] = 0;

    for(i=0; i<4; i++) {
        min = INF;
        u = -1;

        for(j=0; j<5; j++) {
            if(!visited[j] && dist[j] < min) {
                min = dist[j];
                u = j;
            }
        }

        visited[u] = 1;

        for(j=0; j<5; j++) {
            if(!visited[j] && dist[u] + graph[u][j] < dist[j])
                dist[j] = dist[u] + graph[u][j];
        }
    }

    printf("Shortest distances from vertex 0:\n");

    for(i=0; i<5; i++)
        printf("0 -> %d = %d\n", i, dist[i]);

    return 0;
}

Output:

Shortest distances from vertex 0:
0 -> 0 = 0
0 -> 1 = 4
0 -> 2 = 3
0 -> 3 = 6
0 -> 4 = 5
