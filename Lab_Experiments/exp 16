16. Insertion Sort
#include <stdio.h>

int main() {
    int a[10], n, i, j, key;

    printf("Enter number of elements: ");
    scanf("%d", &n);

    printf("Enter elements: ");
    for(i=0; i<n; i++)
        scanf("%d", &a[i]);

    for(i=1; i<n; i++) {
        key = a[i];
        j = i-1;

        while(j>=0 && a[j]>key) {
            a[j+1] = a[j];
            j--;
        }

        a[j+1] = key;
    }

    printf("Sorted array: ");
    for(i=0; i<n; i++)
        printf("%d ", a[i]);

    return 0;
}

Output:

Enter number of elements: 5
Enter elements: 5 2 4 1 3
Sorted array: 1 2 3 4 5
